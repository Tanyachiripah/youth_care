# Runtime mode. Use production on Render.
NODE_ENV=development
# Local fallback only; Render provides PORT in production.
PORT=5000
# Exact browser origin. Required in production, for example https://app.example.org.
CLIENT_URL=http://localhost:5173
# Optional comma-separated list of additional exact trusted browser origins.
ALLOWED_ORIGINS=
# MongoDB Atlas connection string. Use a least-privilege application user.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/youthcare?retryWrites=true&w=majority
# Generate a random secret of at least 32 characters. Do not reuse the example value.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional server-only AI provider credential. Keep unset to use the demo response.
OPENAI_API_KEY=
# Model name used when OPENAI_API_KEY is configured.
OPENAI_MODEL=gpt-4o-mini
# Seed-only account values. Never set on the production web service.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
