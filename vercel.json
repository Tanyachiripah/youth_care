{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build -w client",
  "outputDirectory": "client/dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${RENDER_API_URL}/api/$1",
      "env": ["RENDER_API_URL"]
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
